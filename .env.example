# ---------------------------------------------------------------------------
# consented.eu — environment configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# "prod" or "dev". dev shows stack traces, prod never does.
APP_ENV=prod
APP_NAME="consented.eu"

# Public base URL of the dashboard/marketing site, no trailing slash.
APP_URL=https://consented.eu

# Base URL the CMP runtime and property configs are served from.
# Usually identical to APP_URL; split it out if you put a CDN in front.
CDN_URL=https://consented.eu

# 32+ random bytes, base64. Generate with:
#   php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
APP_KEY=

# Extra secret mixed into password hashes. Changing it invalidates all
# passwords, so set it once before the first user registers.
PASSWORD_PEPPER=

# HMAC key for pseudonymising visitor IPs in the consent log.
# Rotate periodically; old rows stay readable, they just stop correlating.
IP_HASH_PEPPER=

# --- Database ---------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=consentedeu
DB_USER=
DB_PASS=

# --- Redis (optional) -------------------------------------------------------
# Leave REDIS_HOST empty to run without Redis. Rate limiting and caching
# then fall back to the database, which is slower but fully functional.
REDIS_HOST=
REDIS_PORT=6379
REDIS_PREFIX=consented:

# --- Mail -------------------------------------------------------------------
# Mail is NOT configured here.
#
# Messages go out through PHP's mail() over the host MTA. The sender address
# and the on/off switch live in the database (`site_settings`) so they can be
# changed at /admin/settings without a deployment.
#
# While "Mailversand aktiv" is off, nothing is handed to the MTA. Every message
# is still recorded in the `mail_log` table and readable at /admin/mail, so a
# verification link is never lost — it just is not delivered.

# --- Consent storage --------------------------------------------------------
# How long consent records are kept before the retention job deletes them.
CONSENT_RETENTION_MONTHS=36

# --- Registration -----------------------------------------------------------
# Set to 0 on a private self-hosted instance to disable public sign-up.
ALLOW_REGISTRATION=1

# --- Mail --------------------------------------------------------------------
# Der Versandweg (mail oder smtp), Host, Port, Verschlüsselung und Benutzername
# stehen im Admin-Bereich unter Einstellungen → E-Mail. Hier steht nur, was ein
# Geheimnis ist und deshalb nicht in die Datenbank gehört.
#
# SMTP_PASS wird aus Kompatibilität ebenfalls gelesen, falls eine ältere
# Installation den Namen schon benutzt.
SMTP_PASSWORD=

# --- Pro vhost, nicht hier ----------------------------------------------------
# CE_COMING_SOON wird nicht aus dieser Datei gelesen, sondern per SetEnv im
# Apache-vhost gesetzt. So kann derselbe Code auf der Hauptdomain die
# Vorschauseite zeigen und auf dev.* die vollständige Anwendung.
#
#   SetEnv CE_COMING_SOON 1

# --- reCAPTCHA v3 -----------------------------------------------------------
# Beide leer = aus. Es gibt keinen zweiten Schalter: ein Site-Key ohne Secret
# wuerde das Skript laden und dann jede Absendung durchwinken — der Anschein
# eines Schutzes ist schlimmer als keiner.
# Der Site-Key steht ohnehin im ausgelieferten HTML und ist kein Geheimnis.
# Schluessel gibt es unter https://www.google.com/recaptcha/admin
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
# Ab diesem Wert gilt eine Anfrage als menschlich. Googles Empfehlung: 0.5.
RECAPTCHA_MIN_SCORE=0.5

# --- Telegram-Signal fuer Supportanfragen -----------------------------------
# Beide leer = kein Signal. Die Anfrage wird trotzdem gespeichert und im Admin
# angezeigt; der Versand ist eine Zusatzmeldung, keine Voraussetzung.
#
# Die Nachricht ist eine Konstante ohne jede Variable, damit Telegram kein
# Empfaenger personenbezogener Daten und damit kein Auftragsverarbeiter wird.
# tests/signal.php haelt das fest — wer die Nachricht erweitert, faellt dort auf.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
